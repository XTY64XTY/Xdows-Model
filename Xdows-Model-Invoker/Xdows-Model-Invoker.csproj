<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>Xdows_Model_Invoker</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>v2</InformationalVersion>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xdows-Model-Config\Xdows-Model-Config.csproj" SetConfiguration="Configuration=$(Configuration)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Xdows-Model.onnx" Condition="Exists('Xdows-Model.onnx')" />
    <Content Include="Xdows-Model.onnx" Condition="Exists('Xdows-Model.onnx')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Xdows-Model-Flash.onnx" Condition="Exists('Xdows-Model-Flash.onnx')" />
    <Content Include="Xdows-Model-Flash.onnx" Condition="Exists('Xdows-Model-Flash.onnx')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Xdows-Model-Pro.onnx" Condition="Exists('Xdows-Model-Pro.onnx')" />
    <Content Include="Xdows-Model-Pro.onnx" Condition="Exists('Xdows-Model-Pro.onnx')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Xdows-Model-Pro-Standard.onnx" Condition="Exists('Xdows-Model-Pro-Standard.onnx')" />
    <Content Include="Xdows-Model-Pro-Standard.onnx" Condition="Exists('Xdows-Model-Pro-Standard.onnx')"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <EmbeddedResource Include="Xdows-Model-Pro-Flash.onnx" Condition="Exists('Xdows-Model-Pro-Flash.onnx')" />
    <Content Include="Xdows-Model-Pro-Flash.onnx" Condition="Exists('Xdows-Model-Pro-Flash.onnx')"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <EmbeddedResource Include="Xdows-Model-Pro-RawStat.onnx" Condition="Exists('Xdows-Model-Pro-RawStat.onnx')" />
    <Content Include="Xdows-Model-Pro-RawStat.onnx" Condition="Exists('Xdows-Model-Pro-RawStat.onnx')"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <EmbeddedResource Include="Xdows-Model-Pro-Structural.onnx" Condition="Exists('Xdows-Model-Pro-Structural.onnx')" />
    <Content Include="Xdows-Model-Pro-Structural.onnx" Condition="Exists('Xdows-Model-Pro-Structural.onnx')"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>

</Project>
